flowchart TD
    R["Natural-Language Requirement"]
    G["LLM Generation"]
    S["TLA+ Specification"]
    T{{"TLC Verification"}}

    P["Persist Result"]
    L{{"Repair Limit Reached?"}}
    F["Persist Final Failure"]

    M{{"Existing Skill Match?"}}
    A["Apply Repair Skill"]

    N["LLM Skill Proposal"]
    H["👤 Human Approval"]
    I["Human Instruction"]
    NS["Generate Revised Skill"]

    RP["Repair Specification"]

    R --> G --> S --> T

    T -->|Pass| P
    T -->|Fail| L

    L -->|Yes| F
    L -->|No| M

    M -->|Yes| A
    M -->|No| N

    N --> H
    H -->|Y| A
    H -->|N| I
    I --> NS
    NS --> A

    A --> RP --> T

    style T fill:#EAECF7,stroke:#4223C7,stroke-width:3px
    style L fill:#EAECF7,stroke:#4223C7,stroke-width:2px
    style M fill:#EAECF7,stroke:#4223C7,stroke-width:2px
    style H fill:#FFFACD,stroke:#FFB300,stroke-width:2px