flowchart TD
    NL[/"Natural Language<br/>Requirements"/]:::input

    NL --> SPEC[/"LLM-Assisted TLA+<br/>Specification"/]:::step
    SPEC --> SANY["SANY Syntax Validation<br/>(tla2sany.SANY)"]:::step
    SANY -- "Errors" --> SPEC
    SANY -- "Validated Specs" --> MERGE

    NL --> INV[/"LLM-Assisted Refinement<br/>Invariant Synthesis"/]:::step
    INV --> MERGE["Merge with LLM-Assisted<br/>Refinement Invariants"]:::step

    MERGE --> TLC["TLC Model Checking"]:::step
    TLC -- "Violations Found" --> REPAIR[/"Refinement Modeling &<br/>Counterexample Analysis"/]:::step
    REPAIR --> MERGE
    TLC -- "No Violations" --> VALID[/"Validated Model &<br/>Invariants"/]:::output

    classDef input  fill:#EEEDFE,stroke:#534AB7,color:#3C3489
    classDef step   fill:#E6F1FB,stroke:#185FA5,color:#0C447C
    classDef output fill:#E1F5EE,stroke:#0F6E56,color:#085041